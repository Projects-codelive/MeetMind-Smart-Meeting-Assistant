{
  "manifest_version": 3,
  "name": "MeetMind — Smart Meeting Assistant",
  "version": "1.0.0",
  "description": "AI meeting transcription, attention tracking, and automation",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "identity",
    "tabCapture",
    "scripting",
    "cookies",
    "offscreen"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://zoom.us/*",
    "https://teams.microsoft.com/*",
    "http://localhost:3000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [{
    "matches": [
      "https://meet.google.com/*",
      "https://zoom.us/*",
      "https://teams.microsoft.com/*"
    ],
    "js": ["src/content/AudioCapture.ts"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["audio-processor.worklet.js", "offscreen.html"],
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*",
        "https://teams.microsoft.com/*"
      ]
    }
  ]
}